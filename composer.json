{
        "name": "bmlt-enabled/yap",
        "description": "dependencies for yap",
        "license": "MIT",
        "require": {
                    "php": "^8.2.0",
                    "bmlt-enabled/bmlt-root-server-php-client": "^1.0.4",
                    "bmlt/fetch-meditation": "^1.2",
                    "darkaonline/l5-swagger": "^9.0.0",
                    "guzzlehttp/guzzle": "^7.8.1",
                    "laravel/framework": "^12.0.0",
                    "laravel/sanctum": "^4.0.0",
                    "laravel/tinker": "^2.8.2",
                    "phpmailer/phpmailer": "^6.9.1",
                    "twilio/sdk": "^8.0.0"
        },
        "require-dev": {
                    "fakerphp/faker": "^1.23.0",
                    "mockery/mockery": "^1.6.7",
                    "nunomaduro/collision": "^8.8.0",
                    "pestphp/pest-plugin-laravel": "^3.2.0",
                    "phpunit/phpunit": "^11.0.0",
                    "squizlabs/php_codesniffer": "^4.0.0"
        },
        "config": {
                    "vendor-dir": "src/vendor",
                    "optimize-autoloader": true,
                    "preferred-install": "dist",
                    "sort-packages": true,
                    "allow-plugins": {
                                    "pestphp/pest-plugin": true
                    }
        },
        "extra": {
                    "laravel": {
                                    "dont-discover": []
                    }
        },
        "autoload": {
                    "psr-4": {
                                    "App\\": "src/app/",
                                    "Database\\Factories\\": "src/database/factories/",
                                    "Database\\Seeders\\": "src/database/seeders/"
                    }
        },
        "autoload-dev": {
                    "psr-4": {
                                    "Tests\\": "src/tests/"
                    }
        },
        "minimum-stability": "dev",
        "prefer-stable": true
}
